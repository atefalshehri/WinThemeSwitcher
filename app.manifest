<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest. build.rs embeds it into the exe (RT_MANIFEST, id 1)
  with these comments removed and the version filled in: the Cargo.toml
  version plus ".0".

  Keep out: longPathAware (the app passes long paths to Windows in \\?\ form
  itself, and with it the test of that would no longer show anything),
  activeCodePage, and any other setting that changes how Windows APIs
  behave. build.rs and scripts\check-hardening.ps1 refuse either word.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="WinThemeSwitcher" version="{VERSION}"/>

  <!-- Runs with the rights of whoever starts it; never asks for elevation. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Windows 10 and Windows 11 (they share this id). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- Per-monitor DPI awareness from the first dialog on (winit sets it only
       when the event loop is built). dpiAwareness is read by Windows 10 1703
       and later, dpiAware by older versions. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <!-- Version 6 of the common controls: themed message boxes. For this,
       Windows gives the app version 6 of comctl32.dll, from its
       side-by-side store (%SystemRoot%\WinSxS), instead of version 5.82. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
